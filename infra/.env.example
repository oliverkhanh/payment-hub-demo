# Copy sang .env:  cp .env.example .env   (file .env đã được gitignore)
# DEV-ONLY. Production: dùng AWS Secrets Manager, KHÔNG commit secret thật.
# LƯU Ý: các mật khẩu này phải KHỚP với infra/postgres/init/01-init-databases.sql

IDENTITY_DB_PASSWORD=identity_pass
MERCHANT_DB_PASSWORD=merchant_pass
HUB_DB_PASSWORD=hub_pass
BANK_DB_PASSWORD=bank_pass

# Mật khẩu keystore RSA của IdP (dev). Phải khớp mật khẩu lúc sinh keystore.
IDP_KEYSTORE_PASSWORD=changeit
