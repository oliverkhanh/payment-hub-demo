# Dừng tìm lombok.config ở thư mục cha.
config.stopBubbling = true

# ⭐ BẮT BUỘC cho Spring: @RequiredArgsConstructor sinh constructor từ các field final,
# nhưng mặc định nó KHÔNG mang theo annotation của field sang tham số constructor.
# Không khai báo hai dòng dưới thì @Value("${...}") và @Qualifier nằm trên field sẽ bị
# bỏ rơi -> Spring không inject được giá trị từ config -> lỗi lúc khởi động.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier

# Không sinh @java.beans.ConstructorProperties — không cần, và gây nhiễu khi debug.
lombok.anyConstructor.addConstructorProperties = false
